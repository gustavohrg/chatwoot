CHATWOOT_IMAGE=localhost:5000/chatwoot:local-assigned-only
RAILS_PORT=3300

FRONTEND_URL=http://localhost:3300
SECRET_KEY_BASE=replace-me-with-a-long-random-string

POSTGRES_DATABASE=chatwoot_production
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=chatwoot-postgres

REDIS_PASSWORD=redispassword
REDIS_URL=redis://:redispassword@chatwoot-redis:6379

NODE_ENV=production
RAILS_ENV=production
INSTALLATION_ENV=docker
FORCE_SSL=false

ENABLE_ACCOUNT_SIGNUP=true
ENABLE_ACCOUNT_SEEDING=true
CW_RESTRICT_AGENTS_TO_ASSIGNED_CONVERSATIONS=true

MAILER_SENDER_EMAIL=Chatwoot <accounts@example.com>
SMTP_ADDRESS=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=localhost
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=false
SMTP_TLS=false
SMTP_SSL=false
