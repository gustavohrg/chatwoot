CHATWOOT_IMAGE=ghcr.io/<github-user>/chatwoot:<prod-tag>-assigned-only-v1
FRONTEND_URL=https://chatwoot.example.com
SECRET_KEY_BASE=replace_with_long_random_secret
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=replace_with_secure_db_password
POSTGRES_HOST=chatwoot-postgres
REDIS_PASSWORD=replace_with_secure_redis_password
REDIS_URL=redis://default:replace_with_secure_redis_password@chatwoot-redis:6379
NODE_ENV=production
RAILS_ENV=production
INSTALLATION_ENV=docker
MAILER_SENDER_EMAIL=Chatwoot <chatwoot@example.com>
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_DOMAIN=example.com
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=false
SMTP_TLS=true
SMTP_SSL=false
